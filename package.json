{
  "name": "zikamansle-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs && node tests/model.test.cjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy:staging": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply zikamansle-app-staging --local"
  },
  "dependencies": {
    "jose": "6.2.17"
  },
  "devDependencies": {
    "wrangler": "4.160.0"
  }
}
