<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Reserved for ZikaTalk; microphone requested only when explicitly enabled in ZikaTeam. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Only requested after an explicit position request; no background location. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <application
        android:name=".ZikaApplication"
        android:allowBackup="false"
        android:manageSpaceActivity="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
        android:label="@string/app_name"
        android:icon="@drawable/zika_icon"
        android:theme="@style/Theme.ZikaMansle"
        android:usesCleartextTraffic="false">

        <!-- Native entry point: permission is owned by ZikaMansle, never by a Chrome tab. -->
        <activity
            android:name=".ZikaLauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.ZikaMansle">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep links use the same native WebView as main app, keeping ZikaTeam cookies. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.zikamansle.fr" />
            </intent-filter>
        </activity>

        <!-- The application stays in the ZikaMansle process after notification consent. -->
        <activity
            android:name=".ZikaWebActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="false"
            android:launchMode="singleTop"
            android:exported="false"
            android:theme="@style/Theme.ZikaMansle" />

        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.ZikaMansle">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/zika_launch_url" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/brand_navy" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/brand_navy" />
            <meta-data
                android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY"
                android:value="webview" />

        </activity>

        <!-- Required by Android Browser Helper: missing activity crashed the installed app. -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
            android:exported="false">
            <meta-data
                android:name="android.support.customtabs.trusted.MANAGE_SPACE_URL"
                android:value="@string/zika_launch_url" />
        </activity>

        <!-- Private cache only; URI grants are scoped to the chosen camera application. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.zika.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/zika_photo_paths" />
        </provider>

        <!-- Browser fallback when no compatible Trusted Web Activity provider is available. -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.WebViewFallbackActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize" />
        <!-- Respect consent: no FCM registration or analytics collection before opt-in. -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />

        <!-- The official Z notification icon is also used for background FCM messages. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/zika_notification_small" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="festival-zikamansle-alerts-v5" />

        <service
            android:name=".ZikaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Delegates Chrome Web Push to ZikaMansle Android notification channel. -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:enabled="true"
            android:exported="true">
            <meta-data
                android:name="android.support.customtabs.trusted.SMALL_ICON"
                android:resource="@drawable/zika_notification_small" />
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
