{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zikamansle-app-staging",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "keep_vars": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zikamansle-app-staging",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "zikamansle-app-staging"
    }
  ],
  "vars": {
    "APP_ENV": "staging",
    "PUSH_SEND_ENABLED": "false",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "PUSH_TEST_ENABLED": "true",
    "TEAM_PUSH_ENABLED": "false",
    "TEAM_ACCESS_AUD": "",
    "TEAM_AUTH_PROVIDER": "supabase",
    "TEAM_SUPABASE_URL": "https://kuipdwzqamiduhosofjb.supabase.co",
    "TEAM_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_22bY8y3TXUNg_h6xrBztEw_g2nzc2d3"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
